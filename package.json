{
  "name": "jbmopper-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build:mushbot": "node scripts/build-mushbot-standalone.mjs",
    "build": "npm run build:mushbot && astro build",
    "preview": "astro preview",
    "postprocess:observable": "node scripts/postprocess-observable-export.mjs",
    "verify:observable": "npm run build:mushbot && npm run postprocess:observable && node scripts/verify-observable-export.mjs",
    "test:e2e": "playwright test",
    "test:ci": "npm run verify:observable && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.2.5",
    "astro": "^5.18.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "vite": "^6.4.1"
  }
}
