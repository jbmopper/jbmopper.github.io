{
  "name": "jbmopper-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:observable && astro dev",
    "build:jay": "node scripts/build-jay-standalone.mjs",
    "build:inference": "node scripts/build-inference-standalone.mjs",
    "build:observable-widgets": "npm run build:jay && npm run build:inference",
    "prepare:observable": "npm run build:observable-widgets && npm run postprocess:observable",
    "build": "npm run prepare:observable && astro build",
    "preview": "astro preview",
    "postprocess:observable": "node scripts/postprocess-observable-export.mjs",
    "verify:observable": "npm run prepare:observable && node scripts/verify-observable-export.mjs",
    "review:page": "node scripts/review-page.mjs",
    "test:review-page": "node --test scripts/review-page.test.mjs",
    "test:e2e": "playwright test",
    "test:ci": "npm run verify:observable && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/svelte": "^8.0.5",
    "astro": "^6.1.9",
    "marked": "^18.0.0",
    "svelte": "^5.55.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.6.0",
    "vite": "^6.4.2"
  }
}
