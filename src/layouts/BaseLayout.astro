---
import {ClientRouter} from "astro:transitions";
import Jay from "../components/jay/Jay.svelte";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Julius Mopper | Applied AI & Integration",
  description = "Portfolio for Julius Mopper, focused on applied AI, software integration, and product delivery."
} = Astro.props;
const year = new Date().getFullYear();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://juliusm.com").toString();
const previewImage = new URL("/images/projects/site-chatbot.jpg", Astro.site ?? "https://juliusm.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0b1017" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="juliusm.com" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const storageKey = "juliusm-theme";
        const modes = ["system", "dark", "light"];
        const labels = {system: "System", dark: "Dark", light: "Light"};
        const metaColors = {dark: "#0b1017", light: "#f5f7f3"};
        const media = window.matchMedia ? window.matchMedia("(prefers-color-scheme: light)") : null;

        function readPreference() {
          try {
            const stored = window.localStorage.getItem(storageKey);
            if (modes.includes(stored)) return stored;
          } catch {
            return "system";
          }
          return "system";
        }

        function resolvePreference(preference) {
          if (preference === "light" || (preference === "system" && media?.matches)) return "light";
          return "dark";
        }

        function nextPreference(preference) {
          return modes[(modes.indexOf(preference) + 1) % modes.length] || "system";
        }

        function updateControls(preference, resolved) {
          document.querySelectorAll("[data-theme-control]").forEach((control) => {
            const next = nextPreference(preference);
            control.dataset.themePreference = preference;
            control.dataset.themeResolved = resolved;
            control.setAttribute("aria-label", `Theme: ${labels[preference]}. Switch to ${labels[next]}.`);
            control.setAttribute("title", `Theme: ${labels[preference]}`);
            const label = control.querySelector("[data-theme-label]");
            if (label) label.textContent = labels[preference];
          });
        }

        function applyPreference(preference, persist) {
          const normalized = modes.includes(preference) ? preference : "system";
          const resolved = resolvePreference(normalized);
          document.documentElement.dataset.theme = normalized;
          document.documentElement.dataset.themeResolved = resolved;
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", metaColors[resolved]);
          if (persist) {
            try {
              window.localStorage.setItem(storageKey, normalized);
            } catch {
              /* localStorage may be unavailable in private or embedded contexts. */
            }
          }
          updateControls(normalized, resolved);
        }

        function bindControls() {
          document.querySelectorAll("[data-theme-control]").forEach((control) => {
            if (control.dataset.themeBound === "true") return;
            control.dataset.themeBound = "true";
            control.addEventListener("click", () => {
              applyPreference(nextPreference(readPreference()), true);
            });
          });
          applyPreference(readPreference(), false);
        }

        applyPreference(readPreference(), false);
        document.addEventListener("DOMContentLoaded", bindControls);
        document.addEventListener("astro:page-load", bindControls);
        media?.addEventListener("change", () => {
          if (readPreference() === "system") applyPreference("system", false);
        });
        window.addEventListener("storage", (event) => {
          if (event.key === storageKey) applyPreference(readPreference(), false);
        });
      })();
    </script>
  </head>
  <body>
    <ClientRouter />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">juliusm.com</a>
      <div class="header-actions">
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/#welcome">Welcome</a>
          <a href="/observable/projects/">Projects</a>
          <a href="/consulting/">Consulting</a>
          <a href="/resume/">Resume</a>
          <a href="https://linkedin.com/in/jbmopper" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="https://github.com/jbmopper" target="_blank" rel="noreferrer">GitHub</a>
        </nav>
        <button class="theme-control" type="button" data-theme-control data-theme-preference="system">
          <span class="theme-control__icon" aria-hidden="true"></span>
          <span data-theme-label>System</span>
        </button>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>© {year} juliusm.com</footer>
    <Jay client:load transition:persist="chatbot" />
  </body>
</html>

<style is:global>
  @import "../styles/theme-tokens.css";

  /* Must be global: an Astro-scoped `*` selector only matches this layout's own
     markup, so component-rendered form controls kept the content-box default and
     overflowed their grid cells by their padding plus borders. */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
</style>

<style>
  html,
  body {
    margin: 0;
    min-height: 100%;
    font-size: 16px;
    line-height: 1.5;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--bg-ambient-1) 32%, transparent) 0%, transparent 38%),
      linear-gradient(225deg, color-mix(in srgb, var(--bg-ambient-2) 28%, transparent) 0%, transparent 42%),
      linear-gradient(180deg, var(--bg-0) 0%, var(--bg-1) 100%),
      var(--bg-0);
    color: var(--text-0);
    font-family: var(--font-sans);
  }

  html {
    overflow-x: clip;
  }

  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10000;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--stroke);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem clamp(1rem, 3vw, 1.6rem);
    border-bottom: 1px solid var(--stroke);
    background: color-mix(in srgb, var(--bg-0) 88%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--stroke) 70%, transparent);
    backdrop-filter: blur(12px);
  }

  .brand {
    color: var(--text-0);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .nav-links a {
    color: var(--text-1);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.85rem;
    min-width: 0;
  }

  .theme-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.1rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--stroke);
    border-radius: var(--radius-sm);
    background: var(--surface-glass);
    color: var(--text-0);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--stroke) 55%, transparent);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  .theme-control:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-control__icon {
    position: relative;
    width: 0.86rem;
    height: 0.86rem;
    flex: 0 0 auto;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }

  .theme-control[data-theme-preference="light"] .theme-control__icon {
    background: currentColor;
    box-shadow: inset 0 0 0 3px var(--surface);
  }

  .theme-control[data-theme-preference="dark"] .theme-control__icon {
    background: transparent;
    box-shadow: inset -0.28rem 0 0 currentColor;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  
  .panel a {
    color: var(--accent);
  }

  .panel a:hover {
    color: var(--text-0);
  }

  main {
    width: min(1120px, calc(100% - clamp(2rem, 5vw, 4rem)));
    margin: var(--space-6) auto var(--space-7);
  }

  footer {
    border-top: 1px solid var(--stroke);
    color: var(--text-1);
    text-align: center;
    padding: 1rem;
    font-size: 0.9rem;
  }

  @media (max-width: 720px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .header-actions {
      width: 100%;
      justify-content: flex-start;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .nav-links {
      width: 100%;
      justify-content: flex-start;
      row-gap: 0.5rem;
    }

    main {
      width: min(1080px, calc(100% - 1.5rem));
      margin-top: var(--space-5);
      padding-bottom: 4.5rem;
    }
  }
</style>
