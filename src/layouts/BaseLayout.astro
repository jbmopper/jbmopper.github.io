---
import {ClientRouter} from "astro:transitions";
import Jay from "../components/jay/Jay.svelte";
import ThemeSwitcher from "../components/theme/ThemeSwitcher.svelte";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Julius Mopper | AI Systems Engineer",
  description = "Portfolio for Julius Mopper, an AI systems engineer building model, data, and product systems."
} = Astro.props;
const year = new Date().getFullYear();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://juliusm.com").toString();
const previewImage = new URL("/images/jay_cropped.png", Astro.site ?? "https://juliusm.com").toString();

// Build-time git short SHA, surfaced in the footer's build-metadata column.
// Falls back to "dev" if git history isn't available (CI without depth, etc.).
let buildSha = "dev";
try {
  const {execSync} = await import("node:child_process");
  buildSha = execSync("git rev-parse --short HEAD", {encoding: "utf8"}).trim() || "dev";
} catch {
  /* leave as "dev" */
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="juliusm.com" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />

    {/*
      FOUC-safe theme init.
      Runs synchronously, BEFORE the stylesheet is applied (the <style is:global>
      below imports theme-tokens.css which carries the [data-theme][data-mode]
      selectors). This sets data-theme + data-mode on <html> so the very first
      paint uses the persisted palette/mode rather than the :root fallback.
      Same script gets injected into Observable exports by the postprocess script.
    */}
    <script is:inline>
      (function () {
        try {
          var doc = document.documentElement;
          var ls  = window.localStorage;
          var theme = ls && ls.getItem("jm:theme");
          var mode  = ls && ls.getItem("jm:mode");
          if (!theme) theme = "paper";
          if (!mode) {
            // First-visit: respect prefers-color-scheme for mode, default theme is paper.
            mode = (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)
              ? "dark" : "light";
          }
          doc.dataset.theme = theme;
          doc.dataset.mode  = mode;
        } catch (e) {
          document.documentElement.dataset.theme = "paper";
          document.documentElement.dataset.mode  = "light";
        }
      })();
    </script>

    <title>{title}</title>
  </head>
  <body>
    <ClientRouter />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">juliusm.com</a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="/#welcome">Welcome</a>
        <a href="/observable/projects/">Projects</a>
        <a href="/resume/">Resume Generator</a>
        <a href="https://linkedin.com/in/jbmopper" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://github.com/jbmopper" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <ThemeSwitcher client:load />
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="foot-col foot-col--start">
        <span>&copy; {year} juliusm.com</span>
      </div>
      <div class="foot-col foot-col--center">
        <span class="foot-label">BUILD</span>
        <code class="foot-mono">{buildSha}</code>
      </div>
      <div class="foot-col foot-col--end">
        <span class="foot-label">THEME</span>
        <code class="foot-mono" id="foot-theme-indicator" data-fallback="PAPER · LIGHT">PAPER · LIGHT</code>
      </div>
    </footer>
    {/*
      Live theme indicator. Reads data-theme/data-mode from <html> and mirrors
      it into the footer text on every change. Inline so it runs without
      needing another component hydration round-trip.
    */}
    <script is:inline>
      (function () {
        var indicator = document.getElementById("foot-theme-indicator");
        if (!indicator) return;
        function paint() {
          var doc = document.documentElement;
          var t = (doc.dataset.theme  || "paper").toUpperCase();
          var m = (doc.dataset.mode   || "light").toUpperCase();
          indicator.textContent = t + " · " + m;
        }
        paint();
        var mo = new MutationObserver(paint);
        mo.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme", "data-mode"]
        });
      })();
    </script>
    <Jay client:load transition:persist="chatbot" />
  </body>
</html>

<style is:global>
  @import "../styles/theme-tokens.css";
</style>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    font-size: 16px;
    line-height: var(--lh-body);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
  }

  html {
    overflow-x: clip;
  }

  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .skip-link {
    position: fixed;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 10000;
    padding: var(--inset-control);
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--bg-alt);
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    column-gap: var(--space-5);
    row-gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: var(--rule-w) solid var(--rule);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .brand {
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .nav-links a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 0.25rem 0.1rem;
    border-radius: var(--radius);
    transition: var(--transition-press);
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .nav-links a:active {
    transform: translateY(var(--press-shift));
  }

  /*
   * Global :focus-visible — paint an outline using the accent for focus and
   * mark inputs/buttons with a slim outline-offset so the ring sits clear of
   * any soft radius.
   */
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /*
   * Shared "pressable" treatment for any anchor/button-like control that
   * opts in via .pressable. Subtle: 1px translateY + an inset shade.
   * Uses --transition-press from theme-tokens so timing stays consistent.
   */
  :global(.pressable) {
    transition: var(--transition-press);
  }

  :global(.pressable:hover) {
    background: var(--hover-bg);
  }

  :global(.pressable:active) {
    transform: translateY(var(--press-shift));
    box-shadow: var(--press-shadow);
    background: var(--hover-bg-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.pressable),
    :global(.pressable:active),
    .nav-links a,
    .nav-links a:active {
      transition: none;
      transform: none;
    }
  }

  .panel a {
    color: var(--accent);
  }

  .panel a:hover {
    color: var(--fg);
  }

  main {
    width: min(var(--maxw), calc(100% - var(--space-6)));
    margin: var(--gap-section-lg) auto var(--gap-page);
  }

  /* ----------------------------------------------------------------------- */
  /*  Footer — 3-column build-metadata layout                                */
  /* ----------------------------------------------------------------------- */
  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-6);
    border-top: var(--rule-w) solid var(--rule);
    color: var(--fg-muted);
    font-size: var(--fs-small);
  }

  .foot-col {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    min-width: 0;
  }

  .foot-col--start { justify-self: start; }
  .foot-col--center { justify-self: center; }
  .foot-col--end   { justify-self: end; }

  .foot-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .foot-mono {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--fg);
    background: transparent;
  }

  /* ----------------------------------------------------------------------- */
  /*  Responsive                                                             */
  /* ----------------------------------------------------------------------- */
  @media (max-width: 880px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links {
      width: 100%;
      justify-content: flex-start;
      row-gap: var(--space-2);
    }
  }

  @media (max-width: 720px) {
    main {
      width: min(var(--maxw), calc(100% - var(--space-5)));
      margin-top: var(--gap-section);
      padding-bottom: 4.5rem;
    }

    .site-footer {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: var(--space-3);
      padding: var(--space-5);
    }

    .foot-col,
    .foot-col--start,
    .foot-col--center,
    .foot-col--end {
      justify-self: start;
    }
  }
</style>
