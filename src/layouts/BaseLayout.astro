---
import {ClientRouter} from "astro:transitions";
import Jay from "../components/jay/Jay.svelte";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Julius Mopper | AI Systems Engineer",
  description = "Portfolio for Julius Mopper, an AI systems engineer building model, data, and product systems."
} = Astro.props;
const year = new Date().getFullYear();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://juliusm.com").toString();
const previewImage = new URL("/images/jay_cropped.png", Astro.site ?? "https://juliusm.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0c1118" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="juliusm.com" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <ClientRouter />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">juliusm.com</a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="/#welcome">Welcome</a>
        <a href="/observable/projects/">Projects</a>
        <a href="/resume/">Resume Generator</a>
        <a href="https://linkedin.com/in/jbmopper" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://github.com/jbmopper" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>© {year} juliusm.com</footer>
    <Jay client:load transition:persist="chatbot" />
  </body>
</html>

<style is:global>
  @import "../styles/theme-tokens.css";
</style>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    font-size: 16px;
    line-height: 1.5;
    background:
      radial-gradient(1200px 600px at 100% -10%, #1a3850 0%, transparent 60%),
      radial-gradient(900px 500px at -10% 10%, #2a1f3e 0%, transparent 55%),
      var(--bg-0);
    color: var(--text-0);
    font-family: var(--font-sans);
  }

  html {
    overflow-x: clip;
  }

  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10000;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--stroke);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--stroke);
    background: color-mix(in srgb, var(--bg-0) 86%, transparent);
    backdrop-filter: blur(8px);
  }

  .brand {
    color: var(--text-0);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .nav-links a {
    color: var(--text-1);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  
  .panel a {
    color: var(--accent);
  }

  .panel a:hover {
    color: var(--text-0);
  }

  main {
    width: min(1080px, calc(100% - 2rem));
    margin: 2rem auto 3rem;
  }

  footer {
    border-top: 1px solid var(--stroke);
    color: var(--text-1);
    text-align: center;
    padding: 1rem;
    font-size: 0.9rem;
  }

  @media (max-width: 720px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links {
      width: 100%;
      justify-content: flex-start;
      row-gap: 0.5rem;
    }

    main {
      width: min(1080px, calc(100% - 2rem));
      padding-bottom: 4.5rem;
    }
  }
</style>
