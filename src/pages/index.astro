---
import BaseLayout from "../layouts/BaseLayout.astro";

const deepLearningDescription =
  "Fundamentals of deep learning, including transformer implementation in Pytorch, training and inference, performance analysis, hyperparameter tuning, and architectural variations (ablations).";
const resumeGeneratorDescription =
  "A resume generation workflow that tailors output to job descriptions while preserving quality, structure, and clear delivery UX.";
---

<BaseLayout title="juliusm.com | Portfolio Site" description="Julius M's Portfolio Site">
  <section class="hero">
    <p class="eyebrow">Portfolio Site</p>
    <h1>juliusm.com</h1>
    <p class="intro">
      "Applied ML Engineer & Researcher."
    </p>
    <div class="link-row">
      <a href="#welcome">Welcome</a>
      <a href="/observable/projects/">Projects</a>
      <a href="/resume/">Resume Generator</a>
      <a href="https://linkedin.com/in/jbmopper" target="_blank" rel="noreferrer">Contact</a>
    </div>
  </section>

  <section id="welcome" class="panel">
    <h2>Welcome</h2>
    <p>
      This is the portfolio site for Julius Mopper, a talented up-and-coming AI engineer.  Julius has a strong background in machine learning and backend web portal design, having spent over three years in roles specializing in each.

      After a reduction in force at his last position, he has been beavering away learning all about the new era of deep learning.  Julius is sincerely excited about this amazing new technology, and believes we are on the cusp of a true third industrial revolution.

      Please enjoy browsing the writeups he has created for his projects and appreciate his skills in understanding and communicating complex technical topics, applied to his projects.  If you have a job you think might be a good fit for Julius, head over to the <a href="/resume">Resume Generator</a> with your job description and be amazed at the polished, high-quality resume you receive!
    </p>
  </section>

  <section id="projects" class="panel">
    <h2>Projects</h2>
    <article class="project-card">
      <h3><a href="/observable/projects/llm-fundamentals/">Deep Learning Fundamentals</a></h3>
      <p>{deepLearningDescription}</p>
    </article>
    <article class="project-card">
      <h3><a href="/observable/projects/resume-generator/">Resume Generator</a></h3>
      <p>{resumeGeneratorDescription}</p>
    </article>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--stroke);
    border-radius: 14px;
    background: linear-gradient(130deg, color-mix(in srgb, var(--surface) 86%, transparent), var(--surface-2));
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
  }

  .intro {
    margin: 0;
    color: var(--text-1);
    max-width: 65ch;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .link-row a {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--stroke);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-0);
  }

  .link-row a:hover {
    border-color: var(--accent);
  }

  .panel {
    margin-top: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--stroke);
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
  }

  .panel h2 {
    margin: 0 0 0.75rem;
  }

  .project-card h3 {
    margin: 0 0 0.5rem;
  }

  .project-card + .project-card {
    margin-top: 1rem;
  }

  .project-card a {
    color: var(--accent);
  }

  .project-card p {
    margin: 0;
    color: var(--text-1);
  }
</style>
