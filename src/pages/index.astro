---
import BaseLayout from "../layouts/BaseLayout.astro";
import projects from "../data/projects.json";

const publishedProjects = projects.filter((project) => project.status === "published");
const toSiteHref = (href?: string) => {
  const safeHref = href ?? "#";
  return safeHref.startsWith("/projects/") ? `/observable${safeHref}` : safeHref;
};
// Areas of work, not specific projects — so the strip doesn't lie when the
// project list changes shape underneath it. Categories are mutually distinct
// enough that any given project lands cleanly in one cell; "AI products" is
// where new work like the clinical trial matcher slots in.
const focusAreas = [
  {label: "ML Internals",       detail: "Models from scratch: training, inference, GPU profiling, ablations."},
  {label: "AI Products",        detail: "Tools with real production plumbing — auth, async jobs, RAG, eligibility logic."},
  {label: "Published Evidence", detail: "Writeups and notebooks that trace the path from idea to shipped artifact."}
];
---

<BaseLayout title="juliusm.com | Portfolio Site" description="Julius M's Portfolio Site">
  <section class="hero">
    <p class="eyebrow">AI Systems Portfolio</p>
    <h1>Julius Mopper</h1>
    <p class="intro" id="hero-tagline">Building AI systems that <i>survive contact</i> with real users.</p>
    <div class="link-row">
      <a href="#welcome">Welcome</a>
      <a href="/observable/projects/">Projects</a>
      <a href="/resume/">Resume Generator</a>
      <a href="https://linkedin.com/in/jbmopper" target="_blank" rel="noreferrer">LinkedIn</a>
      <a href="https://github.com/jbmopper" target="_blank" rel="noreferrer">GitHub</a>
    </div>
    <div class="focus-strip" aria-label="Areas of work">
      {focusAreas.map((item) => (
        <article class="focus-area">
          <span class="focus-label">{item.label}</span>
          <p class="focus-detail">{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="welcome" class="panel">
    <p class="section-label">01 / Welcome</p>
    <h2>Systems work, with receipts.</h2>
    <!--
    <p>
      This is the portfolio site for Julius Mopper, a talented up-and-coming AI engineer.  Julius has a strong background in machine learning and backend web portal design, having spent over three years in roles specializing in each.
    </p>
    <p>
      After a reduction in force at his last position, he has been beavering away learning all about the new era of deep learning.  Julius is sincerely excited about this amazing new technology, and believes we are on the cusp of a third industrial revolution.
    </p>
    
    <p>
      I'm a researcher and engineer who loves the entire lifecycle of an AI product—from building and training sequence models from scratch, to deploying them via serverless cloud architectures, to ensuring they drive real business value.
    </p>
    <p>
      Check out my project writeups to see how I break down complex deep learning topics, or if you have a role that might be a good fit, head over to the <a href="/resume">Resume Generator</a> with your job description and let my serverless pipeline build a custom resume for you!
    </p>
    -->
    <p>
      The problem is no longer adding features, but controlling complexity. That is the work I like: understanding the model, building the system around it, and getting the result to survive contact with real users. These projects show that range in public: a transformer implemented from scratch, a resume generator with real backend/auth/PDF plumbing, and a RAG chatbot grounded on the site's own corpus.
    </p>
  </section>

  <section id="projects" class="panel">
    <div class="section-heading">
      <p class="section-label">02 / Selected Work</p>
      <h2>Denser proof, less hand-waving.</h2>
    </div>
    <div class="project-list">
      {publishedProjects.map((project, index) => (
      <article class="project-card project-row">
        <a class="project-main" href={`/observable/projects/${project.slug}/`} aria-label={project.title}>
          <span class="project-index">{String(index + 1).padStart(2, "0")}</span>
          <span>
            <span class="project-kicker">{project.category}</span>
            <strong>{project.title}</strong>
            <span class="project-impact">{project.impact}</span>
          </span>
        </a>
        <ul class="proof-list">
          {project.proof?.map((item) => <li>{item}</li>)}
        </ul>
        <div class="project-meta">
          <div class="stack-list" aria-label={`${project.title} stack`}>
            {project.stack?.map((item) => <span>{item}</span>)}
          </div>
          <div class="evidence-list" aria-label={`${project.title} evidence links`}>
            {project.evidenceLinks?.map((item) => (
              <a href={toSiteHref(item.href)}>{item.label}</a>
            ))}
          </div>
        </div>
      </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const taglines = [
      "Building AI systems that <i>survive contact</i> with real users.",
      "From model internals to <i>control planes</i>.",
      "Ambiguous problem, messy system, <i>shippable</i> answer."
    ];
    const el = document.getElementById("hero-tagline");
    if (!el || taglines.length < 2) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const HOLD_MS = 4500;
    const FADE_MS = 350;
    let index = 0;

    setInterval(function () {
      el.classList.add("is-fading");
      window.setTimeout(function () {
        index = (index + 1) % taglines.length;
        el.innerHTML = taglines[index];
        el.classList.remove("is-fading");
      }, FADE_MS);
    }, HOLD_MS);
  })();
</script>

<style>
  .hero {
    display: grid;
    gap: 1.15rem;
    padding: 1.5rem;
    border: 1px solid var(--stroke);
    border-radius: 14px;
    background:
      linear-gradient(130deg, rgba(12, 17, 24, 0.75), rgba(20, 27, 36, 0.65)),
      url('/src/content/hero_bg.png') center / cover no-repeat;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    line-height: 1.05;
  }

  .intro {
    margin: 0;
    color: var(--text-1);
    max-width: 54ch;
    min-height: 1.5em;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    transition: opacity 350ms ease;
  }

  .intro.is-fading {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      transition: none;
    }
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .link-row a {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--stroke);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-0);
  }

  .link-row a:hover {
    border-color: var(--accent);
  }

  /*
   * Focus strip — three "areas of work" cells under the hero.
   * Categories rather than projects, so the strip stays accurate as the
   * project list changes shape underneath.
   */
  .focus-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 0.35rem;
    border: 1px solid var(--stroke);
    background: color-mix(in srgb, var(--bg-0) 72%, transparent);
  }

  .focus-area {
    min-width: 0;
    padding: 0.85rem;
  }

  .focus-area + .focus-area {
    border-left: 1px solid var(--stroke);
  }

  .focus-label,
  .project-index,
  .project-kicker,
  .section-label,
  .stack-list span {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  .focus-label,
  .project-index,
  .project-kicker,
  .section-label {
    color: var(--accent);
  }

  .focus-label {
    display: block;
  }

  .focus-detail {
    margin: var(--space-2) 0 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: var(--lh-body);
  }

  .panel {
    margin-top: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--stroke);
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
  }

  .panel h2 {
    margin: 0 0 0.75rem;
  }

  .section-label {
    margin: 0 0 0.35rem;
  }

  .section-heading {
    margin-bottom: 1rem;
  }

  .panel p a {
    color: var(--accent);
  }

  .panel p a:hover {
    color: var(--text-0);
  }

  .project-list {
    display: grid;
    border-top: 1px solid var(--stroke);
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.9fr) minmax(12rem, 0.6fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--stroke);
  }

  .project-main {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.8rem;
    color: var(--text-0);
    text-decoration: none;
  }

  .project-main strong {
    display: block;
    margin: 0.25rem 0;
    color: var(--text-0);
    font-size: 1.05rem;
  }

  .project-main:hover strong {
    color: var(--accent);
  }

  .project-impact {
    display: block;
    color: var(--text-1);
  }

  .proof-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-1);
  }

  .proof-list li + li {
    margin-top: 0.35rem;
  }

  .project-meta {
    display: grid;
    align-content: start;
    gap: 0.65rem;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0.45rem;
  }

  .stack-list span,
  .evidence-list a {
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--stroke);
    color: var(--text-1);
  }

  .evidence-list {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0.45rem;
  }

  .evidence-list a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .evidence-list a:hover {
    border-color: var(--accent);
    color: var(--text-0);
  }

  @media (max-width: 900px) {
    .project-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .focus-strip {
      grid-template-columns: 1fr;
    }

    .focus-area + .focus-area {
      border-top: var(--rule-w) solid var(--rule-soft);
      border-left: 0;
    }
  }
</style>
