---
import BaseLayout from "../layouts/BaseLayout.astro";
import projects from "../data/projects.json";

const publishedProjects = projects.filter((project) => project.status === "published");
---

<BaseLayout
  title="Julius Mopper | Applied AI & Integration"
  description="Portfolio for Julius Mopper, focused on applied AI, software integration, and product delivery."
>
  <section class="hero">
    <p class="eyebrow">APPLIED GENERATIVE AI</p>
    <h1>Julius Mopper</h1>
    <p class="intro" id="hero-tagline">Turning ambiguity into working systems.</p>
    <div class="link-row">
      <a href="#welcome">Welcome</a>
      <a href="/observable/projects/">Projects</a>
      <a href="/consulting/">Consulting</a>
      <a href="/resume/">Resume</a>
      <a href="https://linkedin.com/in/jbmopper" target="_blank" rel="noreferrer">LinkedIn</a>
      <a href="https://github.com/jbmopper" target="_blank" rel="noreferrer">GitHub</a>
    </div>
  </section>

  <section id="welcome" class="panel">
    <h2>Welcome</h2>
    <!--
    <p>
      This is the portfolio site for Julius Mopper, a talented up-and-coming AI engineer.  Julius has a strong background in machine learning and backend web portal design, having spent over three years in roles specializing in each.
    </p>
    <p>
      After a reduction in force at his last position, he has been beavering away learning all about the new era of deep learning.  Julius is sincerely excited about this amazing new technology, and believes we are on the cusp of a third industrial revolution.
    </p>
    
    <p>
      I'm a researcher and engineer who loves the entire lifecycle of an AI product—from building and training sequence models from scratch, to deploying them via serverless cloud architectures, to ensuring they drive real business value.
    </p>
    <p>
      Check out my project writeups to see how I break down complex deep learning topics, or if you have a role that might be a good fit, head over to the <a href="/resume">Resume Generator</a> with your job description and let my serverless pipeline build a custom resume for you!
    </p>
    <p>
      The problem is no longer adding features, but controlling the complexity. That is the work I like: understanding the model, building the system around it, and getting the result to survive contact with real users. These projects cover that work, from a transformer implemented from scratch to a resume generator with real backend, auth, and PDF plumbing to a RAG chatbot grounded on its own corpus. My background in analysis and enterprise integration turns out to be unusually useful here: ambiguous requirements, messy systems, and the human problem of figuring out what actually needs to be built.
    </p>
    -->
    <p>
      Welcome! I'm Julius, and this is my portfolio and business site. I'm a software integration professional with deep expertise in enterprise architecture, product analysis, project management, and generative AI.  I love tackling the challenges of our ever-evolving business technology landscape: ambiguous requirements, messy systems, and the human problem of figuring out what actually needs to be built.  With deep expertise, strong experience, and a gift for bringing folks together to create outstanding systems that solve hard business problems, I'm eager to learn how I can help you and your organization become even better.  Check out my projects, head to the <a href="/consulting/">consulting intake</a> with a workflow you want to improve, or use the <a href="/resume/">resume generator</a> if you're evaluating my background for a role.
    </p>
  </section>

  <section id="projects" class="panel">
    <h2>Projects</h2>
    <div class="project-grid">
      {publishedProjects.map((project) => {
        const href = `/observable/projects/${project.slug}/`;
        return (
          <article class:list={["project-card", project.art && "project-card--with-art"]}>
            {project.art && (
              <div class="project-card__art">
                <img src={project.art.src} alt={project.art.alt} loading="lazy" decoding="async" />
              </div>
            )}
            <div class="project-card__body">
              <h3><a href={href}>{project.title}</a></h3>
              <p>{project.description}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const taglines = [
      "From ambiguity to <i>results</i>.",
      "Pivot, <i>pivot,</i> pivot...",
      "<i>Own</i> the control plane.",
      "The user <s>is</s> <i>was</> frustrated.",
      "<i>Stochastic governance</i> at scale."
    ];
    const el = document.getElementById("hero-tagline");
    if (!el || taglines.length < 2) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const HOLD_MS = 4500;
    const FADE_MS = 350;
    let index = 0;

    setInterval(function () {
      el.classList.add("is-fading");
      window.setTimeout(function () {
        index = (index + 1) % taglines.length;
        el.innerHTML = taglines[index];
        el.classList.remove("is-fading");
      }, FADE_MS);
    }, HOLD_MS);
  })();
</script>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    min-height: clamp(15rem, 28vw, 20rem);
    align-content: end;
    padding: clamp(1.35rem, 4vw, 2.4rem);
    border: 1px solid var(--stroke);
    border-radius: var(--radius-md);
    background:
      linear-gradient(135deg, rgba(6, 10, 17, 0.86), rgba(17, 18, 31, 0.72) 52%, rgba(42, 30, 34, 0.74)),
      linear-gradient(55deg, rgba(96, 165, 250, 0.14), rgba(139, 92, 246, 0.18) 48%, rgba(244, 201, 93, 0.14)),
      url('/src/content/hero_bg.png') center / cover no-repeat;
    background-blend-mode: normal, color, normal;
    box-shadow: var(--shadow-soft);
    color: #f6f9fc;
  }

  .eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--accent-3) 72%, var(--text-0));
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
  }

  .intro {
    margin: 0;
    color: rgba(246, 249, 252, 0.86);
    max-width: 65ch;
    transition: opacity 350ms ease;
  }

  .intro.is-fading {
    opacity: 0.28;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      transition: none;
    }
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .link-row a {
    padding: 0.5rem 0.9rem;
    border: 1px solid rgba(236, 248, 255, 0.28);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, #07121c 68%, transparent);
    text-decoration: none;
    color: #f6f9fc;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .link-row a:hover {
    border-color: var(--accent);
    color: #ffffff;
  }

  .panel {
    margin-top: var(--space-5);
    padding: clamp(1.15rem, 3vw, 1.8rem);
    border: 1px solid var(--stroke);
    border-radius: var(--radius-md);
    background: var(--surface-glass);
    box-shadow: var(--shadow-card);
  }

  .panel h2 {
    margin: 0 0 var(--space-3);
    line-height: var(--heading-leading);
  }

  .panel p {
    line-height: var(--prose-leading);
  }

  .panel p a {
    color: var(--accent);
  }

  .panel p a:hover {
    color: var(--text-0);
  }

  .project-grid {
    display: grid;
    gap: var(--space-4);
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(13rem, 0.72fr) minmax(0, 1.28fr);
    min-height: 11rem;
    overflow: hidden;
    border: 1px solid var(--stroke);
    border-radius: var(--radius-md);
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--surface-2) 74%, transparent), var(--surface-glass));
  }

  .project-card:not(.project-card--with-art) {
    display: block;
    min-height: 0;
    padding: var(--space-4);
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--accent) 72%, var(--stroke));
    box-shadow: var(--shadow-card);
  }

  .project-card__art {
    display: block;
    min-width: 0;
    min-height: 100%;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 16%, transparent), transparent),
      var(--surface-2);
  }

  .project-card__art img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: var(--image-filter);
  }

  .project-card__body {
    display: grid;
    align-content: center;
    gap: var(--space-2);
    padding: clamp(1rem, 2.6vw, 1.45rem);
  }

  .project-card h3 {
    margin: 0;
    line-height: var(--heading-leading);
  }

  .project-card a {
    color: var(--accent);
  }

  .project-card p {
    margin: 0;
    color: var(--text-1);
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-card__art img {
      aspect-ratio: 16 / 9;
    }
  }
</style>
