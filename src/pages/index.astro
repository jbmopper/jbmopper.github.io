---
import BaseLayout from "../layouts/BaseLayout.astro";
import projects from "../data/projects.json";

const publishedProjects = projects.filter((project) => project.status === "published");
const toSiteHref = (href?: string) => {
  const safeHref = href ?? "#";
  return safeHref.startsWith("/projects/") ? `/observable${safeHref}` : safeHref;
};
const proofStats = [
  {value: "01", label: "Transformer lab", detail: "model internals, training, inference, and GPU traces"},
  {value: "02", label: "Serverless workflows", detail: "challenge-gated APIs, async jobs, and PDF delivery"},
  {value: "03", label: "Grounded assistants", detail: "RAG-backed chat across Astro and Observable pages"}
];
---

<BaseLayout title="juliusm.com | Portfolio Site" description="Julius M's Portfolio Site">
  <section class="hero">
    <p class="eyebrow">AI Systems Portfolio</p>
    <h1>Julius Mopper</h1>
    <p class="intro" id="hero-tagline">Building AI systems that <i>survive contact</i> with real users.</p>
    <div class="link-row">
      <a href="#welcome">Welcome</a>
      <a href="/observable/projects/">Projects</a>
      <a href="/resume/">Resume Generator</a>
      <a href="https://linkedin.com/in/jbmopper" target="_blank" rel="noreferrer">LinkedIn</a>
      <a href="https://github.com/jbmopper" target="_blank" rel="noreferrer">GitHub</a>
    </div>
    <div class="proof-strip" aria-label="Portfolio proof points">
      {proofStats.map((item) => (
        <article class="proof-stat">
          <span>{item.value}</span>
          <strong>{item.label}</strong>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="welcome" class="panel">
    <p class="section-label">01 / Welcome</p>
    <h2>Systems work, with receipts.</h2>
    <!--
    <p>
      This is the portfolio site for Julius Mopper, a talented up-and-coming AI engineer.  Julius has a strong background in machine learning and backend web portal design, having spent over three years in roles specializing in each.
    </p>
    <p>
      After a reduction in force at his last position, he has been beavering away learning all about the new era of deep learning.  Julius is sincerely excited about this amazing new technology, and believes we are on the cusp of a third industrial revolution.
    </p>
    
    <p>
      I'm a researcher and engineer who loves the entire lifecycle of an AI product—from building and training sequence models from scratch, to deploying them via serverless cloud architectures, to ensuring they drive real business value.
    </p>
    <p>
      Check out my project writeups to see how I break down complex deep learning topics, or if you have a role that might be a good fit, head over to the <a href="/resume">Resume Generator</a> with your job description and let my serverless pipeline build a custom resume for you!
    </p>
    -->
    <p>
      The problem is no longer adding features, but controlling complexity. That is the work I like: understanding the model, building the system around it, and getting the result to survive contact with real users. These projects show that range in public: a transformer implemented from scratch, a resume generator with real backend/auth/PDF plumbing, and a RAG chatbot grounded on the site's own corpus.
    </p>
  </section>

  <section id="projects" class="panel">
    <div class="section-heading">
      <p class="section-label">02 / Selected Work</p>
      <h2>Denser proof, less hand-waving.</h2>
    </div>
    <div class="project-list">
      {publishedProjects.map((project, index) => (
      <article class="project-card project-row">
        <a class="project-main" href={`/observable/projects/${project.slug}/`} aria-label={project.title}>
          <span class="project-index">{String(index + 1).padStart(2, "0")}</span>
          <span>
            <span class="project-kicker">{project.category}</span>
            <strong>{project.title}</strong>
            <span class="project-impact">{project.impact}</span>
          </span>
        </a>
        <ul class="proof-list">
          {project.proof?.map((item) => <li>{item}</li>)}
        </ul>
        <div class="project-meta">
          <div class="stack-list" aria-label={`${project.title} stack`}>
            {project.stack?.map((item) => <span>{item}</span>)}
          </div>
          <div class="evidence-list" aria-label={`${project.title} evidence links`}>
            {project.evidenceLinks?.map((item) => (
              <a href={toSiteHref(item.href)}>{item.label}</a>
            ))}
          </div>
        </div>
      </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const taglines = [
      "Building AI systems that <i>survive contact</i> with real users.",
      "From model internals to <i>control planes</i>.",
      "Ambiguous problem, messy system, <i>shippable</i> answer."
    ];
    const el = document.getElementById("hero-tagline");
    if (!el || taglines.length < 2) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const HOLD_MS = 4500;
    const FADE_MS = 350;
    let index = 0;

    setInterval(function () {
      el.classList.add("is-fading");
      window.setTimeout(function () {
        index = (index + 1) % taglines.length;
        el.innerHTML = taglines[index];
        el.classList.remove("is-fading");
      }, FADE_MS);
    }, HOLD_MS);
  })();
</script>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-6);
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius-md);
    background:
      linear-gradient(130deg, color-mix(in srgb, var(--bg) 80%, transparent), color-mix(in srgb, var(--bg-alt) 65%, transparent)),
      url('/src/content/hero_bg.png') center / cover no-repeat;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
  }

  h1 {
    margin: 0;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
  }

  .intro {
    margin: 0;
    color: var(--fg-muted);
    max-width: 54ch;
    min-height: 1.5em;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    transition: opacity 350ms ease;
  }

  .intro.is-fading {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      transition: none;
    }
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /*
   * Anchor-as-button — the primary nav of the hero. Uses the shared press
   * tokens so the feel matches the ThemeSwitcher and any other button.
   */
  .link-row a {
    padding: var(--inset-control);
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    text-decoration: none;
    color: var(--fg);
    font-size: 0.95rem;
    transition: var(--transition-press);
  }

  .link-row a:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--hover-bg);
  }

  .link-row a:active {
    transform: translateY(var(--press-shift));
    box-shadow: var(--press-shadow);
    background: var(--hover-bg-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .link-row a,
    .link-row a:active {
      transition: none;
      transform: none;
    }
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: var(--space-3);
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
  }

  .proof-stat {
    min-width: 0;
    padding: var(--space-4) var(--space-5);
  }

  .proof-stat + .proof-stat {
    border-left: var(--rule-w) solid var(--rule-soft);
  }

  .proof-stat span,
  .project-index,
  .project-kicker,
  .section-label,
  .stack-list span {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .proof-stat span,
  .project-index,
  .project-kicker,
  .section-label {
    color: var(--accent);
  }

  .proof-stat strong {
    display: block;
    margin-top: 0.35rem;
  }

  .proof-stat p {
    margin: 0.25rem 0 0;
    color: var(--text-1);
    font-size: 0.92rem;
  }

  .panel {
    margin-top: var(--gap-section);
    padding: var(--space-6) var(--space-6);
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-alt) 72%, transparent);
  }

  .panel h2 {
    margin: 0 0 var(--space-3);
  }

  .section-label {
    margin: 0 0 var(--space-2);
  }

  .section-heading {
    margin-bottom: var(--space-5);
  }

  .panel p a {
    color: var(--accent);
  }

  .panel p a:hover {
    color: var(--text-0);
  }

  .project-list {
    display: grid;
    border-top: var(--rule-w) solid var(--rule);
    margin-top: var(--space-2);
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.9fr) minmax(12rem, 0.6fr);
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: var(--rule-w) solid var(--rule-soft);
    transition: background-color 90ms ease;
  }

  .project-row:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  .project-main {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-3);
    color: var(--fg);
    text-decoration: none;
  }

  .project-main strong {
    display: block;
    margin: var(--space-1) 0;
    color: var(--fg);
    font-size: 1.05rem;
  }

  .project-main:hover strong {
    color: var(--accent);
  }

  .project-main:active strong {
    transform: translateY(var(--press-shift));
    display: inline-block;
  }

  .project-impact {
    display: block;
    color: var(--fg-muted);
  }

  .proof-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--fg-muted);
  }

  .proof-list li + li {
    margin-top: var(--space-1);
  }

  .project-meta {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--space-2);
  }

  .stack-list span,
  .evidence-list a {
    padding: 0.3rem 0.55rem;
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius);
    color: var(--fg-muted);
  }

  .evidence-list {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--space-2);
  }

  .evidence-list a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
    transition: var(--transition-press);
  }

  .evidence-list a:hover {
    border-color: var(--accent);
    color: var(--fg);
    background: var(--hover-bg);
  }

  .evidence-list a:active {
    transform: translateY(var(--press-shift));
    box-shadow: var(--press-shadow);
    background: var(--hover-bg-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .evidence-list a,
    .evidence-list a:active,
    .project-row {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .project-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .proof-strip {
      grid-template-columns: 1fr;
    }

    .proof-stat + .proof-stat {
      border-top: 1px solid var(--stroke);
      border-left: 0;
    }
  }
</style>
