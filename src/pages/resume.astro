---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeGenerator from "../components/resume/ResumeGenerator.svelte";

const strengths = [
  "Model internals and GPU profiling",
  "Serverless API design and authorization",
  "RAG/product interfaces with production-shaped UX",
  "Evidence-first technical communication"
];

const evidence = [
  {label: "Transformer lab", detail: "Training, inference, ablations, optimizer sweeps, and Nsys trace analysis."},
  {label: "Resume system", detail: "Turnstile verification, signed sessions, async jobs, polling, and PDF handoff."},
  {label: "Site assistant", detail: "Persistent chat across Astro and Observable pages with grounded project context."}
];
---

<BaseLayout title="Resume Generator | Julius Mopper" description="AI-generated tailored resume from a job description">
  <section class="resume-page">
    <header class="resume-proof">
      <p class="eyebrow">Tailored Resume Generator</p>
      <h1>Paste a role. Get the proof lined up.</h1>
      <p class="intro">
        This page is both a utility and a live artifact: the generator is backed by a challenge-gated, session-authorized, async resume workflow, and the surrounding evidence explains what the resume is drawing from.
      </p>
      <div class="proof-grid">
        <section>
          <h2>Target Roles</h2>
          <p>AI systems engineer, full-stack AI product engineer, ML platform-adjacent backend engineer, and technical generalist roles that need model literacy plus shipping discipline.</p>
        </section>
        <section>
          <h2>Operating Strengths</h2>
          <ul>
            {strengths.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>
    </header>

    <section class="evidence-panel" aria-labelledby="selected-evidence">
      <div>
        <p class="eyebrow">Selected Evidence</p>
        <h2 id="selected-evidence">What the generator can emphasize</h2>
      </div>
      <div class="evidence-list">
        {evidence.map((item) => (
          <article>
            <h3>{item.label}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="generator-panel" aria-label="Resume generator">
      <ResumeGenerator client:load />
    </section>
  </section>
</BaseLayout>

<style>
  .resume-page {
    display: grid;
    gap: var(--gap-section);
  }

  .resume-proof,
  .evidence-panel {
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-alt) 72%, transparent);
  }

  .resume-proof {
    padding: var(--space-6);
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 12ch;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
  }

  .intro {
    max-width: 68ch;
    margin: var(--space-5) 0 0;
    color: var(--fg-muted);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .proof-grid section {
    min-width: 0;
    padding-top: var(--space-4);
    border-top: var(--rule-w) solid var(--rule-soft);
  }

  .proof-grid h2,
  .evidence-panel h2,
  .evidence-list h3 {
    margin: 0;
  }

  .proof-grid p,
  .proof-grid ul,
  .evidence-list p {
    margin: var(--space-3) 0 0;
    color: var(--fg-muted);
  }

  .proof-grid ul {
    padding-left: 1.1rem;
  }

  .proof-grid li + li {
    margin-top: var(--space-1);
  }

  .evidence-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-5);
    padding: var(--space-6);
  }

  .evidence-list {
    display: grid;
    gap: var(--space-5);
  }

  .evidence-list article {
    padding-bottom: var(--space-5);
    border-bottom: var(--rule-w) solid var(--rule-soft);
  }

  .evidence-list article:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .generator-panel {
    padding-top: var(--space-2);
  }

  @media (max-width: 760px) {
    .proof-grid,
    .evidence-panel {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: 100%;
    }
  }
</style>
